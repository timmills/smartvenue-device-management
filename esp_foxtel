    number: GPIO2
    inverted: true

# Multiple IR Transmitters for Foxtel boxes
remote_transmitter:
  # Box 0 (Default) - GPIO14 (D5)
  - pin: GPIO14
    carrier_duty_percent: 50%
    id: ir_transmitter_0

  # Box 1 - GPIO12 (D6)  
  - pin: GPIO12
    carrier_duty_percent: 50%
    id: ir_transmitter_1

  # Box 2 - GPIO13 (D7)
  - pin: GPIO13
    carrier_duty_percent: 50%
    id: ir_transmitter_2

  # Box 3 - GPIO15 (D8)
  - pin: GPIO15
    carrier_duty_percent: 50%
    id: ir_transmitter_3

  # Box 4 - GPIO16 (D0)
  - pin: GPIO16
    carrier_duty_percent: 50%
    id: ir_transmitter_4

# ================================================================
# FOXTEL IR COMMAND SCRIPTS
# ================================================================

script:
  # Smart channel parser and sender for Foxtel
  - id: smart_foxtel_channel
    parameters:
      channel_str: string
    then:
      - lambda: |-
          std::string input = channel_str;
          int box_id = 0;  // Default to Box 0
          int channel = 0;
          
          ESP_LOGI("FOXTEL", "Processing channel input: %s", input.c_str());
          
          // Check for box prefix (format: "2-501" or "0-501")
          size_t dash_pos = input.find("-");
          if (dash_pos != std::string::npos) {
            // Found dash, extract box number and channel
            std::string box_str = input.substr(0, dash_pos);
            std::string channel_str = input.substr(dash_pos + 1);
            
            box_id = std::stoi(box_str);
            channel = std::stoi(channel_str);
            
            ESP_LOGI("FOXTEL", "Parsed: Box %d, Channel %d", box_id, channel);
          } else {
            // No dash, treat as channel number for Box 0
            channel = std::stoi(input);
            ESP_LOGI("FOXTEL", "No prefix - Box 0, Channel %d", channel);
          }
          
          // Validate box number
          if (box_id < 0 || box_id > 4) {
            ESP_LOGW("FOXTEL", "Invalid box number: %d", box_id);
            return;
          }
          
          // Validate channel number
          if (channel < 0 || channel > 9999) {
            ESP_LOGW("FOXTEL", "Invalid channel: %d", channel);
            return;
          }
          
          // Store for digit sequence
          id(target_box) = box_id;
          id(channel_digits) = std::to_string(channel);
          id(digit_index) = 0;
          
      - script.execute: send_next_foxtel_digit

  - id: send_next_foxtel_digit
    mode: restart
    then:
      - lambda: |-
          if (id(digit_index) < id(channel_digits).length()) {
            int digit = id(channel_digits)[id(digit_index)] - '0';
            int box = id(target_box);
            ESP_LOGI("FOXTEL", "Box %d - Channel digit: %d", box, digit);
            
            // Send digit to specific Foxtel box
            id(send_foxtel_digit).execute(box, digit);
            id(digit_index)++;
            
            if (id(digit_index) < id(channel_digits).length()) {
              return;
            } else {
              ESP_LOGI("FOXTEL", "Box %d - Channel sequence complete", box);
            }
          }
      - if:
          condition:
            lambda: 'return id(digit_index) < id(channel_digits).length();'
          then:
            - delay: 750ms  # Longer delay for Foxtel boxes (750ms vs 300ms)
            - script.execute: send_next_foxtel_digit

  # Send Foxtel digit to specific box
  - id: send_foxtel_digit
    parameters:
      box_id: int
      digit: int
    then:
      - lambda: |-
          ESP_LOGI("FOXTEL", "Sending digit %d to box %d", digit, box_id);
          
          // Foxtel digit codes (Pronto Hex format)
          std::string foxtel_digits[] = {
            "0000 0073 0000 0012 000F 000A 0006 000A 0006 0016 0006 000A 0006 0010 0006 0016 0006 0016 0006 000A 0006 000A 0006 000A 0006 0016 0006 0010 0006 0016 0006 000A 0006 000A 0006 000A 0006 000A 0006 0CAB", // 0
            "0000 0073 0000 0012 000F 000A 0006 000A 0006 0016 0006 000A 0006 0010 0006 0016 0006 0016 0006 000A 0006 000A 0006 000A 0006 0016 0006 0010 0006 0016 0006 000A 0006 000A 0006 000A 0006 0010 0006 0CA5", // 1
            "0000 0073 0000 0012 000F 000A 0006 000A 0006 0016 0006 000A 0006 0010 0006 0016 0006 0016 0006 000A 0006 000A 0006 000A 0006 0016 0006 0010 0006 0016 0006 000A 0006 000A 0006 000A 0006 0016 0006 0C9F", // 2
            "0000 0073 0000 0012 000F 000A 0006 000A 0006 0016 0006 000A 0006 0010 0006 0016 0006 0016 0006 000A 0006 000A 0006 000A 0006 0016 0006 0010 0006 0016 0006 000A 0006 000A 0006 000A 0006 001C 0006 0C99", // 3
            "0000 0073 0000 0012 000F 000A 0006 000A 0006 0016 0006 000A 0006 0010 0006 0016 0006 0016 0006 000A 0006 000A 0006 000A 0006 0016 0006 0010 0006 0016 0006 000A 0006 000A 0006 0010 0006 000A 0006 0CA5", // 4
            "0000 0073 0000 0012 000F 000A 0006 000A 0006 0016 0006 000A 0006 0010 0006 0016 0006 0016 0006 000A 0006 000A 0006 000A 0006 0016 0006 0010 0006 0016 0006 000A 0006 000A 0006 0010 0006 0010 0006 0C9F", // 5
            "0000 0073 0000 0012 000F 000A 0006 000A 0006 0016 0006 000A 0006 0010 0006 0016 0006 0016 0006 000A 0006 000A 0006 000A 0006 0016 0006 0010 0006 0016 0006 000A 0006 000A 0006 0010 0006 0016 0006 0C99", // 6
            "0000 0073 0000 0012 000F 000A 0006 000A 0006 0016 0006 000A 0006 0010 0006 0016 0006 0016 0006 000A 0006 000A 0006 000A 0006 0016 0006 0010 0006 0016 0006 000A 0006 000A 0006 0010 0006 001C 0006 0C93", // 7
            "0000 0073 0000 0012 000F 000A 0006 000A 0006 0016 0006 000A 0006 0010 0006 0016 0006 0016 0006 000A 0006 000A 0006 000A 0006 0016 0006 0010 0006 0016 0006 000A 0006 000A 0006 0016 0006 000A 0006 0C9F", // 8
            "0000 0073 0000 0012 000F 000A 0006 000A 0006 0016 0006 000A 0006 0010 0006 0016 0006 0016 0006 000A 0006 000A 0006 000A 0006 0016 0006 0010 0006 0016 0006 000A 0006 000A 0006 0016 0006 0010 0006 0C99"  // 9
          };
          
          if (digit < 0 || digit > 9) {
            ESP_LOGW("FOXTEL", "Invalid digit: %d", digit);
            return;
          }
          
          // Store current digit code and box for action calls
          id(current_pronto_code) = foxtel_digits[digit];
          id(current_box) = box_id;
          
      # Send Pronto code based on box
      - if:
          condition:
            lambda: 'return id(current_box) == 0;'
          then:
            - remote_transmitter.transmit_pronto:
                transmitter_id: ir_transmitter_0
                data: !lambda 'return id(current_pronto_code);'
          else:
            - if:
                condition:
                  lambda: 'return id(current_box) == 1;'
                then:
                  - remote_transmitter.transmit_pronto:
                      transmitter_id: ir_transmitter_1
                      data: !lambda 'return id(current_pronto_code);'
                else:
                  - if:
                      condition:
                        lambda: 'return id(current_box) == 2;'
                      then:
                        - remote_transmitter.transmit_pronto:
                            transmitter_id: ir_transmitter_2
                            data: !lambda 'return id(current_pronto_code);'
                      else:
                        - if:
                            condition:
                              lambda: 'return id(current_box) == 3;'
                            then:
                              - remote_transmitter.transmit_pronto:
                                  transmitter_id: ir_transmitter_3
                                  data: !lambda 'return id(current_pronto_code);'
                            else:
                              - if:
                                  condition:
                                    lambda: 'return id(current_box) == 4;'
                                  then:
                                    - remote_transmitter.transmit_pronto:
                                        transmitter_id: ir_transmitter_4
                                        data: !lambda 'return id(current_pronto_code);'

  # Power command for specific Foxtel box
  - id: foxtel_box_power
    parameters:
      box_id: int
    then:
      - lambda: |-
          ESP_LOGI("FOXTEL", "Power command for Box %d", box_id);
          id(current_box) = box_id;
          // Foxtel power code
          id(current_pronto_code) = "0000 0073 0000 0012 000F 000A 0006 000A 0006 0016 0006 000A 0006 0010 0006 0016 0006 0016 0006 000A 0006 000A 0006 000A 0006 0016 0006 0010 0006 0016 0006 000A 0006 000A 0006 001C 0006 000A 0006 0C99";
          
      - if:
