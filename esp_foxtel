                else:
                  - if:
                      condition:
                        lambda: 'return id(current_box) == 2;'
                      then:
                        - remote_transmitter.transmit_pronto:
                            transmitter_id: ir_transmitter_2
                            data: !lambda 'return id(current_pronto_code);'
                      else:
                        - if:
                            condition:
                              lambda: 'return id(current_box) == 3;'
                            then:
                              - remote_transmitter.transmit_pronto:
                                  transmitter_id: ir_transmitter_3
                                  data: !lambda 'return id(current_pronto_code);'
                            else:
                              - if:
                                  condition:
                                    lambda: 'return id(current_box) == 4;'
                                  then:
                                    - remote_transmitter.transmit_pronto:
                                        transmitter_id: ir_transmitter_4
                                        data: !lambda 'return id(current_pronto_code);'

  # Mute command for specific Foxtel box
  - id: foxtel_box_mute
    parameters:
      box_id: int
    then:
      - lambda: |-
          ESP_LOGI("FOXTEL", "Mute command for Box %d", box_id);
          id(current_box) = box_id;
          // Foxtel mute code
          id(current_pronto_code) = "0000 0073 0000 0012 000F 000A 0006 000A 0006 0016 0006 000A 0006 0010 0006 0016 0006 0016 0006 000A 0006 000A 0006 000A 0006 0016 0006 0010 0006 0016 0006 000A 0006 000A 0006 001C 0006 0010 0006 0C93";
          
      - if:
