# ================================================================
# COASTAL COMMUNICATIONS 5-OUTPUT FOXTEL IR BLASTER
# ================================================================
# 
# PRODUCTION VERSION - MULTI-FOXTEL BOX CONTROL
# 
# Features:
# ✅ 5 Independent IR outputs (0-4) for Foxtel boxes
# ✅ Smart channel system with box prefix (2-501 → Box 2, Channel 501)
# ✅ Backward compatible (no prefix or 0- uses original output)
# ✅ Native Pronto Hex support - no conversion needed
# ✅ Complete Foxtel command set (Power, Mute, Ch+/-, 0-9)
# ✅ Clean entity naming (ir_abc123_xxx)
# ✅ Hidden WiFi network support
# ✅ Zero configuration deployment
#
# Hardware Requirements:
# - Wemos D1 Mini
# - 5x 5mm IR LED (940nm)
# - 5x 220Ω resistor
# - Extension wires as needed
#
# GPIO Mapping:
# - Box 0 (default): GPIO14 (D5)
# - Box 1: GPIO12 (D6)
# - Box 2: GPIO13 (D7) 
# - Box 3: GPIO15 (D8)
# - Box 4: GPIO16 (D0)
#
# Network: "FOXTEL" (hidden) / "rdL1R7iDpXDx4O"
#
# ================================================================

esphome:
  name: "ir"
  friendly_name: "5-Output Foxtel IR Blaster"
  comment: "Coastal Communications 5-Output Foxtel IR Blaster"
  name_add_mac_suffix: true
  
  project:
    name: "coastalcomms.5-output-foxtel"
    version: "1.0.0"
    
  # Log IP address on boot
  on_boot:
    priority: -100  # Run after WiFi connects
    then:
      - delay: 5s  # Give WiFi time to fully connect
      - lambda: |-
          ESP_LOGI("BOOT", "=================================");
          ESP_LOGI("BOOT", "Device: %s", App.get_name().c_str());
          ESP_LOGI("BOOT", "IP Address: %s", WiFi.localIP().toString().c_str());
          ESP_LOGI("BOOT", "MAC Address: %s", WiFi.macAddress().c_str());
          ESP_LOGI("BOOT", "=================================");

esp8266:
  board: d1_mini
  restore_from_flash: true

logger:
  level: INFO

# ================================================================
# HOME ASSISTANT API & SERVICES
# ================================================================

api:
  encryption:
    key: "uuPgF8JOAV/ZhFbDV4iS4Kwr1MV5H97p6Nk+HnpE0+g="
  
  services:
    # ============================================================
    # SMART MULTI-BOX CHANNEL SERVICE - FOXTEL VERSION
    # ============================================================
    # Usage Examples:
    # channel: "501"     → Box 0 (default), Channel 501
    # channel: "0-501"   → Box 0 (explicit), Channel 501  
    # channel: "2-501"   → Box 2, Channel 501
    # channel: "4-125"   → Box 4, Channel 125
    # ============================================================
    - service: tv_channel
      variables:
        channel: string
      then:
        - script.execute:
            id: smart_foxtel_channel
            channel_str: !lambda 'return channel;'

    # Individual box power controls
    - service: tv_power
      variables:
        box: int
      then:
        - script.execute:
            id: foxtel_box_power
            box_id: !lambda 'return box;'

    # Individual box mute controls
    - service: tv_mute
      variables:
        box: int
      then:
        - script.execute:
            id: foxtel_box_mute
            box_id: !lambda 'return box;'

    # Channel up/down controls
    - service: tv_channel_up
      variables:
        box: int
      then:
        - script.execute:
            id: foxtel_box_channel_up
            box_id: !lambda 'return box;'

    - service: tv_channel_down
      variables:
        box: int
      then:
        - script.execute:
            id: foxtel_box_channel_down
            box_id: !lambda 'return box;'

